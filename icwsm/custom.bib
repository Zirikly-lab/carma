@inproceedings{zirikly-etal-2019-clpsych,
    title = "{CLP}sych 2019 Shared Task: Predicting the Degree of Suicide Risk in {R}eddit Posts",
    author = {Zirikly, Ayah  and
      Resnik, Philip  and
